# 复制本文件为 .env.development.local 后生效（*.local 已被 .gitignore 忽略）
# 注意：VITE_ 前缀的变量会打进前端包，绝不能放密钥。

# 后端地址。必须用 127.0.0.1，不要用 localhost。
VITE_API_BASE=http://127.0.0.1:8001

# true = 走 MSW 模拟（无后端也能开发）；false = 直连真实后端
VITE_USE_MOCK=true

# 仅 mock 模式生效：answered | refuse | unavailable | unauthorized
VITE_MOCK_SCENARIO=answered
