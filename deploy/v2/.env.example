# Copy to .env, generate a fresh local password, and chmod 600 .env.
# Prefer: python deploy/v2/init_env.py (never overwrites an existing .env).
DS_V2_DB_NAME=ds_assistant_v2
DS_V2_DB_USER=ds_assistant_v2
DS_V2_DB_PASSWORD=
DS_V2_DB_HOST=127.0.0.1
DS_V2_DB_PORT=5433

# Secure defaults; production origins must be explicit HTTPS origins (JSON list).
DS_V2_ENVIRONMENT=production
DS_V2_ALLOW_INSECURE_LOOPBACK=false
DS_V2_ALLOWED_ORIGINS=[]
DS_V2_SESSION_TTL_SECONDS=28800
DS_V2_LOGIN_MAX_FAILURES=5
DS_V2_LOGIN_IP_MAX_FAILURES=20
DS_V2_LOGIN_WINDOW_SECONDS=900
# For LOCAL HTTP only, explicitly replace the environment/origin values above:
# DS_V2_ENVIRONMENT=development
# DS_V2_ALLOW_INSECURE_LOOPBACK=true
# DS_V2_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:8001"]

# 3B-2B: disabled unless explicitly configured. Never copy keys from the V1 root .env.
DS_V2_EMBEDDING_PROVIDER=disabled
DS_V2_EMBEDDING_CLOUD_ENABLED=false
DS_V2_EMBEDDING_API_KEY=
DS_V2_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
DS_V2_EMBEDDING_MODEL_REVISION=unverified
DS_V2_EMBEDDING_DIMENSION=1024
DS_V2_EMBEDDING_BATCH_SIZE=10
# Configure the official workspace endpoint if your account requires one.
# Global opt-in is insufficient: POST /documents/{doc_id}/embedding with allow_cloud=true
# is also required for each current document parsing generation.
